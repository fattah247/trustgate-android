<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and lower: backup is off, and these exclusions keep it that way if it's ever turned on. -->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
